{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": ".test-dist/src",
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "src/core/**/*.ts",
    "src/astronomy/time/**/*.ts",
    "src/astronomy/spk/**/*.ts",
    "src/data/md5.ts",
    "src/render/eclipse.ts"
  ]
}
